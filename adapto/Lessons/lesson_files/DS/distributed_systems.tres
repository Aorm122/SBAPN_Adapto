[sub_resource type="Resource" id="Resource_dis_01"]
script = ExtResource("1_7hrog")
id = "DIS_01"
term = "Strong Consistency"
keyword = "Data view"
definition = "Ensures all clients see the most recent write, even if it means increased latency, by synchronizing updates across all replicas before acknowledging success."
simple_terms = "Everyone sees the same up-to-date data at all times."
examples = ["Banking ledger", "Stock trading", "Seat booking"]
accepted_terms = ["Linearizability", "Atomic Consistency"]
difficulty = 2
related_to = ["Core Concepts", "System Properties", "Data Management", "Reliability & Resilience"]
tof_statement = {
"false": "Strong consistency allows different replicas to show different data for a short period after a write", 
"true": "A system demonstrating strong consistency will block reads until all replicas are updated with the l"
}
type_of_information = ["definition", "explain", "apply"]
clues = ["This property is crucial when data integrity is paramount.", "It often requires global agreement before an operation is considered complete.", "Think about systems where seeing stale data could lead to critical errors, like financial transactions."]
distractors = ["Eventual Consistency", "Availability", "Partition Tolerance"]
metadata/_custom_type_script = "uid://dadne10e1geqd"

