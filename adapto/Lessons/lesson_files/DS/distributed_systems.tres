term = "Two-Phase Commit"
keyword = "Atomic commit"
definition = "A distributed algorithm that ensures all participating nodes in a distributed transaction either commit or abort the transaction together, maintaining atomicity across multiple resources."
simple_terms = "All systems agree to do or undo a change completely."
examples = ["XA transactions", "Distributed databases", "Enterprise systems"]
accepted_terms = ["2PC"]
difficulty = 3
