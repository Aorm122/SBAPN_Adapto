[sub_resource type="Resource" id="Resource_dis_03"]
script = ExtResource("1_7hrog")
id = "DIS_03"
term = "Partition Tolerance"
keyword = "Network split"
definition = "The ability of a distributed system to continue operating despite network failures that split the system into isolated sub-systems, by allowing individual nodes to operate independently."
simple_terms = "System keeps working even if network breaks between parts."
examples = ["Cloud storage", "Blockchain", "NoSQL DB"]
accepted_terms = ["Network Partition"]
difficulty = 2
related_to = ["Core Concepts", "System Properties", "Reliability & Resilience"]
tof_statement = {
"false": "Partition tolerance means the system can automatically heal network connections that have failed.", 
"true": "A partition-tolerant system can continue processing requests even if parts of its network become unr"
}
type_of_information = ["definition", "explain", "apply"]
clues = ["This property addresses communication breakdowns.", "It's one of the three trade-offs in the CAP theorem.", "Consider a scenario where half your data centers go offline but the other half must continue serving requests."]
distractors = ["Fault Tolerance", "Scalability", "Data Replication"]
metadata/_custom_type_script = "uid://dadne10e1geqd"

[sub_resource type="Resource" id="Resource_dis_04"]
script = ExtResource("1_7hrog")
id = "DIS_04"
term = "Eventual Consistency"
keyword = "Data propagation"
definition = "Achieves high availability and partition tolerance by allowing temporary inconsistencies, but guarantees that all replicas will eventually converge to the same state if no new writes occur."
simple_terms = "Data might be stale for a bit, but it will catch up later."
examples = ["DNS updates", "Social media feed", "Shopping cart"]
accepted_terms = ["Eventual"]
difficulty = 2
related_to = ["Core Concepts", "System Properties", "Data Management"]
tof_statement = {
"false": "Eventual consistency means data is never guaranteed to be the same across all nodes.", 
"true": "A system with eventual consistency prioritizes availability and performance over immediate data cons"
}
type_of_information = ["definition", "explain", "apply"]
clues = ["This model is often chosen when speed and continuous operation are critical.", "It accepts temporary divergence in data views.", "Think about systems where seeing slightly outdated information for a moment is acceptable, like a friend's post count."]
distractors = ["Strong Consistency", "Atomic Consistency", "Durability"]
metadata/_custom_type_script = "uid://dadne10e1geqd"

