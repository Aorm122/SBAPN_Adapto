}
type_of_information = ["definition", "explain", "apply"]
clues = ["It's a more advanced way to establish event order than a single counter.", "Helps identify if events happened concurrently or sequentially.", "Each process maintains an array of timestamps, one for each process."]
distractors = ["Lamport Clock", "Physical Clock", "Global Time Server"]
