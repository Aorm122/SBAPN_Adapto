[sub_resource type="Resource" id="Resource_dsc_01"]
script = ExtResource("1_7hrog")
id = "DSC_01"
term = "Remote Procedure Call"
keyword = "remote invocation"
definition = "Allows a program to execute a procedure on a remote server as if it were a local call, simplifying distributed programming by abstracting network details."
simple_terms = "Calling a function on another computer."
examples = ["gRPC", "SOAP", "XML-RPC"]
accepted_terms = ["RPC"]
difficulty = 1
related_to = ["Distributed Systems", "Messaging", "Coordination"]
tof_statement = {
"false": "RPC requires explicit network socket programming for every remote interaction.", 
"true": "RPC hides network complexities, allowing developers to focus on application logic."
}
type_of_information = ["definition", "explain", "apply"]
clues = ["It's about making a remote action seem local.", "Think about how you'd call a function in a different process.", "A client-server interaction where the client doesn't know it's remote."]
distractors = ["Message Queue", "REST API", "Shared Memory"]
metadata/_custom_type_script = "uid://dadne10e1geqd"

[sub_resource type="Resource" id="Resource_dsc_02"]
script = ExtResource("1_7hrog")
id = "DSC_02"
term = "Message Passing"
keyword = "asynchronous"
definition = "Enables processes to communicate by sending and receiving discrete messages, decoupling sender and receiver and often supporting asynchronous operations."
simple_terms = "Programs sending data packets to each other."
examples = ["Kafka", "RabbitMQ", "ZeroMQ"]
accepted_terms = []
difficulty = 1
related_to = ["Distributed Systems", "Messaging", "Coordination"]
tof_statement = {
"false": "Message passing is a synchronous communication mechanism, blocking the sender until a reply is recei", 
"true": "Message passing inherently provides a loose coupling between communicating components."
}
type_of_information = ["definition", "explain", "apply"]
clues = ["Components interact without direct function calls.", "It's a way for systems to exchange information without waiting.", "Imagine putting a letter in a mailbox for someone else to pick up later."]
distractors = ["Remote Procedure Call", "Shared Memory", "Direct Memory Access"]
metadata/_custom_type_script = "uid://dadne10e1geqd"

[sub_resource type="Resource" id="Resource_dsc_03"]
script = ExtResource("1_7hrog")
id = "DSC_03"
term = "Domain Name System"
keyword = "name resolution"
definition = "Translates human-readable domain names into numerical IP addresses, facilitating resource location and access across the internet."
simple_terms = "Translating website names to computer addresses."
examples = ["google.com", "192.0.2.1", "example.org"]
accepted_terms = ["DNS"]
difficulty = 1
related_to = ["Distributed Systems", "Identification", "Messaging"]
tof_statement = {
"false": "DNS primarily focuses on synchronizing clocks across a distributed network.", 
"true": "DNS is a hierarchical and distributed system designed for mapping names to addresses."
}
type_of_information = ["definition", "explain", "apply"]
clues = ["How do you find a website by its name?", "It's a global directory for internet addresses.", "The system that turns 'www.example.com' into an IP address."]
distractors = ["NTP", "DHCP", "LDAP"]
metadata/_custom_type_script = "uid://dadne10e1geqd"

[sub_resource type="Resource" id="Resource_dsc_04"]
script = ExtResource("1_7hrog")
id = "DSC_04"
term = "Logical Clock"
keyword = "event ordering"
definition = "Provides a mechanism to order events in a distributed system without relying on synchronized physical time, establishing a 'happened-before' relationship."
simple_terms = "Ordering events based on their causal relation."
examples = ["Lamport clock", "Vector clock", "Interval clock"]
accepted_terms = ["Logical Clocks"]
difficulty = 2
related_to = ["Distributed Systems", "Coordination", "Consistency"]
tof_statement = {
"false": "A logical clock is used to achieve exact time synchronization between all nodes in a distributed sys", 
"true": "A logical clock helps determine the causal order of events in a distributed system, even if physical"
}
type_of_information = ["definition", "explain", "apply"]
clues = ["It's about understanding event sequence, not exact time.", "Helps establish cause and effect in a distributed environment.", "A counter that increments with events and message exchanges."]
distractors = ["Physical Clock", "Atomic Clock", "System Timer"]
metadata/_custom_type_script = "uid://dadne10e1geqd"

[sub_resource type="Resource" id="Resource_dsc_05"]
script = ExtResource("1_7hrog")
id = "DSC_05"
term = "Mutual Exclusion"
keyword = "critical section"
definition = "Ensures that only one process or thread can access a shared resource or critical section at any given time, preventing data corruption and race conditions."
simple_terms = "Allowing only one access to a shared item."
examples = ["Locks", "Semaphores", "Monitors"]
accepted_terms = []
difficulty = 2
related_to = ["Distributed Systems", "Coordination", "Consistency"]
tof_statement = {
"false": "Mutual exclusion is primarily used to ensure all nodes have the same data at all times.", 
"true": "Distributed mutual exclusion algorithms aim to grant a critical section to only one process at a tim"
}
type_of_information = ["definition", "explain", "apply"]
clues = ["It's about preventing simultaneous access to something important.", "A mechanism to ensure exclusive use of a shared resource.", "Only one entity can be in a specific 'protected' area at once."]
distractors = ["Deadlock Prevention", "Livelock Resolution", "Concurrency Control"]
metadata/_custom_type_script = "uid://dadne10e1geqd"

[sub_resource type="Resource" id="Resource_dsc_06"]
script = ExtResource("1_7hrog")
id = "DSC_06"
term = "Idempotency"
keyword = "safe retries"
definition = "A property of an operation where executing it multiple times has the same effect as executing it once, crucial for reliable communication in unreliable networks."
simple_terms = "Doing something many times has one result."
examples = ["Read requests", "Delete requests", "Set value"]
accepted_terms = ["Idempotent"]
difficulty = 2
related_to = ["Distributed Systems", "Messaging", "Consistency"]
tof_statement = {
"false": "An idempotent operation guarantees that the operation will always succeed on the first attempt.", 
"true": "Designing an API operation to be idempotent helps in safely retrying requests without unintended sid"
}
type_of_information = ["definition", "explain", "apply"]
clues = ["It's about the consistency of outcomes from repeated actions.", "Ensures that performing an action again won't change the state further.", "Think about an action that can be safely retried."]
distractors = ["Atomicity", "Durability", "Consistency (ACID)"]
metadata/_custom_type_script = "uid://dadne10e1geqd"

