examples = ["XA transactions", "Database commits", "atomic transaction"]
accepted_terms = ["2PC"]
difficulty = 3
related_to = ["Distributed Systems", "Coordination", "Consistency"]
tof_statement = {
"false": "Two-Phase Commit is primarily used to reduce network latency in distributed communication.", 
"true": "Two-Phase Commit guarantees atomicity across multiple resources in a distributed transaction by requ"
}
type_of_information = ["definition", "explain", "apply"]
clues = ["It's a way to ensure a distributed operation either fully succeeds or fully fails.", "Involves a 'prepare' and a 'commit' stage across multiple systems.", "A coordinator asks all participants to vote before making a final decision."]
distractors = ["Three-Phase Commit", "Paxos", "Leader Election"]
