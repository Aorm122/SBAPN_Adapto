[sub_resource type="Resource" id="Resource_dsc_09"]
script = ExtResource("1_7hrog")
id = "DSC_09"
term = "Two-Phase Commit"
keyword = "atomic transaction"
definition = "A distributed algorithm that ensures all participating nodes in a distributed transaction either commit or abort the transaction atomically, maintaining data consistency."
