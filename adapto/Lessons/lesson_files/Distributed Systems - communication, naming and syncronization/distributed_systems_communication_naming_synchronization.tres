[sub_resource type="Resource" id="Resource_dsc_13"]
script = ExtResource("1_7hrog")
id = "DSC_13"
term = "Causal Consistency"
keyword = "cause-effect"
definition = "A consistency model that ensures if one event causally precedes another, then all nodes will observe the causally preceding event before the causally succeeding event, respecting causality."
simple_terms = "Related actions are seen in order."
examples = ["Version vectors", "Message ordering", "cause-effect"]
accepted_terms = []
difficulty = 3
related_to = ["Distributed Systems", "Consistency", "Coordination"]
tof_statement = {
"false": "Causal consistency requires all operations to be totally ordered across all replicas, regardless of ", 
"true": "Causal consistency ensures that if event A causes event B, then any observer seeing B will also have"
}
type_of_information = ["definition", "explain", "apply"]
clues = ["It's about preserving the 'happened-before' relationship for related events.", "Ensures that effects are seen after their causes.", "A weaker model than strong consistency, but stronger than eventual."]
distractors = ["Strong Consistency", "Linearizability", "Read-Your-Writes Consistency"]
metadata/_custom_type_script = "uid://dadne10e1geqd"

