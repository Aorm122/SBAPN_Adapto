}
type_of_information = ["definition", "explain", "apply"]
clues = ["It's about reaching a collective decision despite potential issues.", "How do all parts of a system come to a single agreement?", "Algorithms like Paxos or Raft aim to solve this."]
distractors = ["Leader Election", "Atomic Broadcast", "Two-Phase Commit"]
