[sub_resource type="Resource" id="Resource_dsc_10"]
script = ExtResource("1_7hrog")
id = "DSC_10"
term = "Eventual Consistency"
keyword = "relaxed consistency"
definition = "A consistency model where, if no new updates are made to a given data item, all reads of that item will eventually return the last updated value, trading immediate consistency for availability."
simple_terms = "Data will become the same over time."
examples = ["DynamoDB", "Cassandra", "S3"]
accepted_terms = []
difficulty = 2
related_to = ["Distributed Systems", "Consistency", "Coordination"]
tof_statement = {
"false": "Eventual consistency ensures that all replicas are always up-to-date with the latest write at any gi", 
"true": "Eventual consistency allows for higher availability and partition tolerance by accepting temporary i"
}
type_of_information = ["definition", "explain", "apply"]
clues = ["It's about data becoming uniform eventually, not instantly.", "Think about a database where updates propagate over time.", "Reads might return stale data for a short period after a write."]
distractors = ["Strong Consistency", "Linearizability", "Sequential Consistency"]
metadata/_custom_type_script = "uid://dadne10e1geqd"

