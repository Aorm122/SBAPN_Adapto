[sub_resource type="Resource" id="Resource_uml_24"]
script = ExtResource("1_7hrog")
id = "UML_24"
term = "Decision Node"
keyword = "Choice"
definition = "An element in an Activity Diagram that represents a point where the flow of control can branch based on a condition, leading to different subsequent activities."
simple_terms = "Where a process can go one of several ways."
examples = ["IsValid?", "HasStock?", "IsApproved?"]
accepted_terms = []
difficulty = 1
related_to = ["UML Diagrams", "System Behavior", "Behavioral Views"]
tof_statement = {
"false": "A Decision Node is used to start multiple parallel activities simultaneously.", 
"true": "A Decision Node allows an activity flow to diverge based on boolean conditions, like 'approved' or '"
}
type_of_information = ["definition", "explain", "apply"]
clues = ["It's where a choice is made in a workflow.", "Represented by a diamond shape in an activity diagram.", "If the system needs to check 'if (condition is true)', this is used."]
distractors = ["A point where a single action is performed.", "A point where parallel flows begin.", "A point where parallel flows synchronize and merge."]
metadata/_custom_type_script = "uid://dadne10e1geqd"

[sub_resource type="Resource" id="Resource_uml_25"]
script = ExtResource("1_7hrog")
id = "UML_25"
term = "Fork Node"
keyword = "Parallel Start"
definition = "An element in an Activity Diagram that represents the splitting of a single incoming flow into multiple concurrent (parallel) outgoing flows of control, enabling parallel execution."
simple_terms = "Starting multiple tasks at the same time."
examples = ["ProcessOrder", "PrepareShipping", "SendConfirmation"]
accepted_terms = []
difficulty = 2
related_to = ["UML Diagrams", "System Behavior", "Behavioral Views"]
tof_statement = {
"false": "A Fork Node represents a conditional choice between different paths in a workflow.", 
"true": "A Fork Node is used when several independent tasks can be executed simultaneously after a certain po"
}
type_of_information = ["definition", "explain", "apply"]
clues = ["It allows multiple activities to happen at once.", "Represented by a thick horizontal or vertical bar.", "If you 'process payment' AND 'update inventory' at the same time, this starts it."]
distractors = ["A node that merges multiple parallel flows back into one.", "A node that makes a conditional choice between paths.", "A node that represents a single, atomic action."]
metadata/_custom_type_script = "uid://dadne10e1geqd"

[sub_resource type="Resource" id="Resource_uml_26"]
script = ExtResource("1_7hrog")
id = "UML_26"
term = "Join Node"
keyword = "Parallel End"
definition = "An element in an Activity Diagram that represents the synchronization of multiple incoming concurrent flows into a single outgoing flow, requiring all incoming flows to complete before proceeding."
simple_terms = "Waiting for all parallel tasks to finish."
examples = ["AllPartsReady", "DeliveryComplete", "ReportGenerated"]
accepted_terms = []
difficulty = 2
related_to = ["UML Diagrams", "System Behavior", "Behavioral Views"]
tof_statement = {
"false": "A Join Node allows the process to continue as soon as any one of the incoming parallel flows complet", 
"true": "A Join Node ensures that all parallel activities have finished before the process can continue to th"
}
type_of_information = ["definition", "explain", "apply"]
clues = ["It brings together multiple parallel activities.", "Represented by a thick horizontal or vertical bar.", "If 'payment processed' AND 'inventory updated' must both finish before 'order confirmed', this ends it."]
distractors = ["A node that splits a single flow into multiple parallel ones.", "A node that makes a conditional choice between paths.", "A node that represents a single, atomic action."]
metadata/_custom_type_script = "uid://dadne10e1geqd"

[sub_resource type="Resource" id="Resource_uml_27"]
script = ExtResource("1_7hrog")
id = "UML_27"
term = "Sequence Diagram"
keyword = "Interaction"
definition = "A behavioral diagram that illustrates how objects interact with each other over time, showing the order of messages exchanged between them to achieve a specific functionality."
simple_terms = "How objects talk to each other, step-by-step."
examples = ["UserLogin", "ItemAddToCart", "ProcessRefund"]
accepted_terms = []
difficulty = 1
related_to = ["UML Diagrams", "System Behavior", "Behavioral Views"]
tof_statement = {
"false": "A Sequence Diagram defines the static relationships between classes in a system.", 
"true": "A Sequence Diagram is excellent for visualizing the detailed flow of control and messages in a speci"
}
type_of_information = ["definition", "explain", "apply"]
clues = ["It focuses on the timing and order of communications.", "You'd use this to trace an execution path through multiple objects.", "Think of vertical lifelines and horizontal arrows representing calls."]
distractors = ["A diagram showing the different states an object can be in.", "A diagram depicting the overall workflow of a business process.", "A diagram illustrating the physical deployment of software components."]
metadata/_custom_type_script = "uid://dadne10e1geqd"

[sub_resource type="Resource" id="Resource_uml_28"]
script = ExtResource("1_7hrog")
id = "UML_28"
term = "Lifeline"
keyword = "Participant"
definition = "An element in a Sequence Diagram that represents an individual participant (an object or an actor) in the interaction, showing its existence over a period of time."
simple_terms = "An object or actor involved in a sequence."
examples = ["user:User", "orderMgr:Order", "db:Database"]
accepted_terms = []
difficulty = 1
related_to = ["UML Diagrams", "System Behavior", "Behavioral Views"]
tof_statement = {
"false": "A Lifeline defines the conditions under which a message is sent between objects.", 
"true": "A Lifeline visually represents the active existence of an object during an interaction scenario."
}
type_of_information = ["definition", "explain", "apply"]
clues = ["It's a vertical dashed line representing an object's existence.", "Messages are sent to and from these participants.", "If you have a 'Customer' and an 'Order Processor' in an interaction, each has one."]
distractors = ["A message sent between objects.", "A condition that controls the flow of messages.", "A block representing a segment of interaction logic."]
metadata/_custom_type_script = "uid://dadne10e1geqd"

[sub_resource type="Resource" id="Resource_uml_29"]
script = ExtResource("1_7hrog")
id = "UML_29"
term = "Message"
keyword = "Communication"
definition = "An element in a Sequence Diagram that represents communication between two lifelines, indicating an operation call, a signal, or the creation/destruction of an object."
simple_terms = "How objects talk to each other."
examples = ["createUser()", "saveOrder()", "returnResult()"]
accepted_terms = []
difficulty = 1
related_to = ["UML Diagrams", "System Behavior", "Behavioral Views"]
tof_statement = {
"false": "Messages are used to define the static attributes of an object.", 
"true": "Messages on a Sequence Diagram illustrate the dynamic method calls or data exchanges between objects"
}
type_of_information = ["definition", "explain", "apply"]
clues = ["It's the actual call or signal exchanged between objects.", "Represented by horizontal arrows between vertical lines.", "When a 'Controller' asks a 'Service' to 'doSomething()', that's one of these."]
distractors = ["A condition that must be met for an action to occur.", "A container for a group of related interactions.", "A participant in the interaction scenario."]
metadata/_custom_type_script = "uid://dadne10e1geqd"

[sub_resource type="Resource" id="Resource_uml_30"]
script = ExtResource("1_7hrog")
id = "UML_30"
term = "State Machine Diagram"
keyword = "Lifecycle"
definition = "A behavioral diagram that models the dynamic behavior of an object by showing the sequences of states it goes through, the events that trigger transitions, and the actions performed in response."
simple_terms = "How an object changes its status over time."
examples = ["OrderStatus", "TrafficLight", "ATMState"]
accepted_terms = ["Statechart Diagram"]
difficulty = 2
related_to = ["UML Diagrams", "System Behavior", "Behavioral Views"]
tof_statement = {
"false": "A State Machine Diagram describes the data flow between different components of a system.", 
"true": "A State Machine Diagram helps analyze the complete lifecycle of an object and predict its behavior u"
}
type_of_information = ["definition", "explain", "apply"]
clues = ["It shows how an object's condition changes over time.", "You'd use this to model complex lifecycles of entities.", "Think about an 'Order' going from 'New' to 'Processing' to 'Shipped'."]
distractors = ["A diagram illustrating the sequence of messages between objects.", "A diagram showing the static structure of classes and their relationships.", "A diagram depicting the physical deployment of software components."]
metadata/_custom_type_script = "uid://dadne10e1geqd"

[sub_resource type="Resource" id="Resource_uml_31"]
script = ExtResource("1_7hrog")
id = "UML_31"
term = "State"
keyword = "Condition"
definition = "A condition or situation during the lifetime of an object in which it satisfies some condition, performs some activity, or waits for some event, represented in a State Machine Diagram."
simple_terms = "A specific status an object is in."
examples = ["Idle", "Active", "Suspended"]
accepted_terms = []
difficulty = 1
related_to = ["UML Diagrams", "System Behavior", "Behavioral Views"]
tof_statement = {
"false": "A State represents a specific action performed by an object, rather than its condition.", 
"true": "An object's behavior can differ significantly depending on the state it is currently in."
}
type_of_information = ["definition", "explain", "apply"]
clues = ["It's a particular status or mode an object can be in.", "Represented by a rounded rectangle in a state diagram.", "An 'Order' can be in 'Pending', 'Confirmed', or 'Delivered' status."]
distractors = ["An event that causes an object to change its condition.", "An action performed by an object when it enters a state.", "A transition path between two different conditions."]
metadata/_custom_type_script = "uid://dadne10e1geqd"

[sub_resource type="Resource" id="Resource_uml_32"]
script = ExtResource("1_7hrog")
id = "UML_32"
term = "Transition"
keyword = "Change"
definition = "A change from one state to another state, triggered by an event, and potentially guarded by a condition, with an optional action performed during the state change in a State Machine Diagram."
simple_terms = "Moving from one status to another."
examples = ["OrderPlaced", "ItemShipped", "PaymentFailed"]
accepted_terms = []
difficulty = 2
related_to = ["UML Diagrams", "System Behavior", "Behavioral Views"]
tof_statement = {
"false": "A Transition represents a period during which an object remains in a stable condition.", 
"true": "A Transition defines the rules and events under which an object moves from one state to another."
}
type_of_information = ["definition", "explain", "apply"]
clues = ["It's what causes an object to move from one condition to another.", "Represented by an arrow connecting two states.", "When an 'Order' is 'Confirmed', it might move from 'Pending' to 'Processing' via this."]
distractors = ["A stable condition that an object can be in.", "An action performed while an object is in a particular state.", "A specific event that occurs but does not necessarily change state."]
metadata/_custom_type_script = "uid://dadne10e1geqd"

