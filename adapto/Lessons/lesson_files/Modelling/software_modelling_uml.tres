[sub_resource type="Resource" id="Resource_uml_19"]
script = ExtResource("1_7hrog")
id = "UML_19"
term = "Use Case"
keyword = "Functionality"
definition = "A sequence of actions performed by a system, often in collaboration with actors, to yield an observable result of value to a particular actor, representing a system's functional requirement."
