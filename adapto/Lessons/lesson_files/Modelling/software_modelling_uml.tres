clues = ["It describes a high-level system function from a user's view.", "Represented by an oval shape in a requirements diagram.", "If a user wants to 'checkout', that's one of these."]
distractors = ["A detailed step-by-step algorithm for a specific task.", "A class that encapsulates data and behavior.", "A physical device where software is deployed."]
