[sub_resource type="Resource" id="Resource_uml_01"]
script = ExtResource("1_7hrog")
id = "UML_01"
term = "UML Standard"
keyword = "Language"
definition = "A standardized visual language used to specify, visualize, construct, and document the artifacts of a software-intensive system, providing a common blueprint for development teams."
simple_terms = "Visual blueprint for building software systems."
examples = ["System architecture", "Requirements doc", "Design model"]
accepted_terms = ["Unified Modeling Language"]
difficulty = 1
related_to = ["UML Diagrams", "Software Design", "Modeling Concepts"]
tof_statement = {
"false": "UML primarily generates executable code directly from diagrams.", 
"true": "UML helps teams understand complex systems by providing a common visual language."
}
type_of_information = ["definition", "explain", "apply"]
clues = ["It's a common language for system blueprints.", "It helps teams communicate complex software ideas visually.", "Think of it as the agreed-upon way to draw software designs."]
distractors = ["A programming language for system implementation.", "A project management methodology for software teams.", "A testing framework for validating software functionality."]
metadata/_custom_type_script = "uid://dadne10e1geqd"

[sub_resource type="Resource" id="Resource_uml_02"]
script = ExtResource("1_7hrog")
id = "UML_02"
term = "Software Model"
keyword = "Abstraction"
definition = "An abstraction of a software system that represents its structure, behavior, and architecture, allowing developers to understand and reason about complex systems before implementation."
simple_terms = "Simplified representation of a complex system."
examples = ["Class relationships", "User flows", "Deployment map"]
accepted_terms = ["System Model", "Design Model"]
difficulty = 1
related_to = ["UML Diagrams", "Software Design", "Modeling Concepts"]
tof_statement = {
"false": "A software model is primarily used to directly debug running code.", 
"true": "Creating a software model helps identify potential design flaws early in the development cycle."
}
type_of_information = ["definition", "explain", "apply"]
clues = ["It simplifies reality to focus on key aspects.", "Developers use it to plan and understand systems before building.", "It's a conceptual representation, not the actual code."]
distractors = ["The final executable code of a system.", "A database containing all system requirements.", "A document outlining project management tasks."]
metadata/_custom_type_script = "uid://dadne10e1geqd"

[sub_resource type="Resource" id="Resource_uml_03"]
script = ExtResource("1_7hrog")
id = "UML_03"
term = "UML Diagram"
keyword = "Visualization"
definition = "A visual representation within a UML model that illustrates specific aspects of a system, enabling stakeholders to grasp complex relationships and behaviors quickly."
simple_terms = "Picture showing part of a software design."
examples = ["Class", "Sequence", "Use Case"]
accepted_terms = ["UML Chart"]
difficulty = 1
related_to = ["UML Diagrams", "Software Design", "Modeling Concepts"]
tof_statement = {
"false": "UML diagrams are primarily for generating user interface mockups.", 
"true": "UML diagrams help clarify how different parts of a system interact by showing relationships visually"
}
type_of_information = ["definition", "explain", "apply"]
clues = ["It's a graphical view of a system's structure or behavior.", "You draw these to communicate design ideas.", "Think of it as a specific drawing type within the overall blueprint."]
distractors = ["A written specification of system requirements.", "A project timeline showing task dependencies.", "A spreadsheet tracking software bugs."]
metadata/_custom_type_script = "uid://dadne10e1geqd"

[sub_resource type="Resource" id="Resource_uml_04"]
script = ExtResource("1_7hrog")
id = "UML_04"
term = "Model Element"
keyword = "Building Block"
definition = "A fundamental constituent of a UML model, representing a specific concept such as a class, object, or interaction, used to construct meaningful diagrams."
simple_terms = "Basic piece used to build a UML diagram."
examples = ["Class", "Actor", "Message"]
accepted_terms = []
difficulty = 1
related_to = ["UML Diagrams", "Software Design", "Modeling Concepts"]
tof_statement = {
"false": "Model elements are only relevant for coding, not for design.", 
"true": "Identifying key model elements is the first step in constructing any UML diagram."
}
type_of_information = ["definition", "explain", "apply"]
clues = ["These are the distinct parts you place on a diagram.", "Each one represents a specific idea or component.", "If you're drawing a class diagram, 'Class' itself is one of these."]
distractors = ["The lines connecting different parts of a diagram.", "The overall structure of a complete software system.", "A comment or note added to a diagram for clarification."]
metadata/_custom_type_script = "uid://dadne10e1geqd"

[sub_resource type="Resource" id="Resource_uml_05"]
script = ExtResource("1_7hrog")
id = "UML_05"
term = "UML Relationship"
keyword = "Connection"
definition = "A connection between two or more model elements that specifies how they relate to each other, such as association, generalization, or dependency, to define system structure or behavior."
simple_terms = "How different parts of a system are linked."
examples = ["Association", "Generalization", "Dependency"]
accepted_terms = []
difficulty = 1
related_to = ["UML Diagrams", "Software Design", "Modeling Concepts"]
tof_statement = {
"false": "UML relationships are primarily used to define the user interface layout.", 
"true": "UML relationships are crucial for understanding how changes in one part of a system might affect ano"
}
type_of_information = ["definition", "explain", "apply"]
clues = ["It shows how one part interacts with or depends on another.", "These are often represented by lines or arrows on a diagram.", "Think about how objects or classes 'know about' or 'use' each other."]
distractors = ["A description of an element's internal properties.", "A specific type of diagram for showing system architecture.", "A textual annotation explaining a diagram's purpose."]
metadata/_custom_type_script = "uid://dadne10e1geqd"

[sub_resource type="Resource" id="Resource_uml_06"]
script = ExtResource("1_7hrog")
id = "UML_06"
term = "Stereotype"
keyword = "Extension"
definition = "A mechanism in UML that allows you to extend the vocabulary of UML by defining new types of model elements, relationships, or properties, enabling domain-specific modeling."
simple_terms = "Customizing UML for specific needs."
examples = ["<<interface>>", "<<controller>>", "<<entity>>"]
accepted_terms = []
difficulty = 2
related_to = ["UML Diagrams", "Software Design", "Modeling Concepts"]
tof_statement = {
"false": "Stereotypes replace standard UML elements with entirely new graphical symbols.", 
"true": "Stereotypes help make a UML diagram more expressive by adding domain-specific meanings to standard e"
}
type_of_information = ["definition", "explain", "apply"]
clues = ["It's a way to add special meaning to a standard UML item.", "You often see these enclosed in guillemets (<< >>).", "If you need a 'Service' class, but UML only has 'Class', you might use this."]
distractors = ["A type of diagram used for showing user interactions.", "A predefined set of rules for drawing UML diagrams.", "A comment block used to explain complex parts of a diagram."]
metadata/_custom_type_script = "uid://dadne10e1geqd"

[sub_resource type="Resource" id="Resource_uml_07"]
script = ExtResource("1_7hrog")
id = "UML_07"
term = "Class Diagram"
keyword = "Structure"
definition = "A structural diagram that describes the static structure of a system by showing its classes, their attributes, operations, and the relationships among them, like inheritance or association."
simple_terms = "Blueprint of system classes and their connections."
examples = ["User", "Order", "Product"]
accepted_terms = []
difficulty = 1
related_to = ["UML Diagrams", "Software Design", "Structural Views"]
tof_statement = {
"false": "A Class Diagram primarily depicts the flow of control within a system.", 
"true": "A Class Diagram is essential for designing the object-oriented architecture of a system."
}
type_of_information = ["definition", "explain", "apply"]
clues = ["It shows the building blocks of an object-oriented system.", "You'd use this to define types of data and functions.", "Think about how different conceptual entities in your system relate statically."]
distractors = ["A diagram showing how users interact with a system's features.", "A diagram illustrating the sequence of messages between objects.", "A diagram detailing the physical deployment of software components."]
metadata/_custom_type_script = "uid://dadne10e1geqd"

[sub_resource type="Resource" id="Resource_uml_08"]
script = ExtResource("1_7hrog")
id = "UML_08"
term = "Association"
keyword = "Link"
definition = "A general relationship between two classes that indicates a structural connection, where instances of one class are connected to instances of another, often with multiplicity."
simple_terms = "A general link between two class types."
examples = ["Customer-Order", "Student-Course", "Car-Driver"]
accepted_terms = []
difficulty = 1
related_to = ["UML Diagrams", "Software Design", "Structural Views"]
tof_statement = {
"false": "An association indicates that one class directly inherits from another.", 
"true": "An association helps define how objects of different classes can interact or refer to each other."
}
type_of_information = ["definition", "explain", "apply"]
clues = ["It's a basic connection, showing that two things are related.", "Often represented by a solid line between classes.", "If a 'Person' has a 'Car', this relationship exists."]
distractors = ["A relationship where one class is a specialized version of another.", "A relationship indicating a whole-part connection with shared lifetime.", "A relationship showing that one class uses another temporarily."]
metadata/_custom_type_script = "uid://dadne10e1geqd"

[sub_resource type="Resource" id="Resource_uml_09"]
script = ExtResource("1_7hrog")
id = "UML_09"
term = "Aggregation"
keyword = "Weak Whole-Part"
definition = "A specialized form of association representing a 'whole-part' relationship where the parts can exist independently of the whole, implying a weaker ownership."
simple_terms = "\"Has a\" relationship where parts can be shared."
examples = ["Department-Professor", "Car-Wheel", "Team-Player"]
accepted_terms = []
difficulty = 2
related_to = ["UML Diagrams", "Software Design", "Structural Views"]
tof_statement = {
"false": "Aggregation means that if the 'whole' object is destroyed, its 'part' objects are also automatically", 
"true": "If a university department is deleted, its professors can still exist, which is an example of aggreg"
}
type_of_information = ["definition", "explain", "apply"]
clues = ["It's a 'has-a' relationship, but the parts aren't strictly owned.", "Represented by a hollow diamond on the 'whole' side.", "Think of a car and its wheels; the wheels can be used on another car."]
distractors = ["A strong 'whole-part' relationship where parts cannot exist alone.", "A relationship where one class inherits behavior from another.", "A simple directional link indicating one-way communication."]
metadata/_custom_type_script = "uid://dadne10e1geqd"

[sub_resource type="Resource" id="Resource_uml_10"]
script = ExtResource("1_7hrog")
id = "UML_10"
term = "Composition"
keyword = "Strong Whole-Part"
definition = "A strong form of aggregation where the part objects' lifecycle is dependent on the whole; if the whole is destroyed, its parts are also destroyed, implying exclusive ownership."
simple_terms = "\"Has a\" relationship with strict ownership."
examples = ["House-Room", "Order-LineItem", "Polygon-Point"]
accepted_terms = []
difficulty = 2
related_to = ["UML Diagrams", "Software Design", "Structural Views"]
tof_statement = {
"false": "Composition allows a 'part' object to be independently created and then attached to multiple 'whole'", 
"true": "If a 'House' object is deleted, its 'Room' objects are also implicitly removed, demonstrating compos"
}
type_of_information = ["definition", "explain", "apply"]
clues = ["It's a 'has-a' relationship where the parts cannot exist without the whole.", "Represented by a filled diamond on the 'whole' side.", "Consider an 'Order' and its 'Line Items'; an item cannot exist without an order."]
distractors = ["A relationship indicating that one class is a subtype of another.", "A weak 'whole-part' relationship where parts can exist independently.", "A simple association between two unrelated classes."]
metadata/_custom_type_script = "uid://dadne10e1geqd"

[sub_resource type="Resource" id="Resource_uml_11"]
script = ExtResource("1_7hrog")
id = "UML_11"
term = "Generalization"
keyword = "Inheritance"
definition = "A relationship between a more general classifier (superclass) and a more specific classifier (subclass), where the subclass inherits attributes and operations from the superclass."
simple_terms = "\"Is a\" relationship, where one type is more specific."
examples = ["Animal-Dog", "Shape-Circle", "Vehicle-Car"]
accepted_terms = ["Inheritance"]
difficulty = 1
related_to = ["UML Diagrams", "Software Design", "Structural Views"]
tof_statement = {
"false": "Generalization describes how two distinct classes collaborate to perform a task.", 
"true": "Generalization helps reuse common behavior and attributes by defining them once in a superclass."
}
type_of_information = ["definition", "explain", "apply"]
clues = ["It's an 'is-a' kind of connection between classes.", "Represented by a solid line with an unfilled arrowhead pointing to the general class.", "If a 'Dog' is a type of 'Animal', this relationship applies."]
distractors = ["A relationship showing a 'whole-part' structure.", "A relationship indicating one class uses another's services.", "A connection between objects that send messages to each other."]
metadata/_custom_type_script = "uid://dadne10e1geqd"

[sub_resource type="Resource" id="Resource_uml_12"]
script = ExtResource("1_7hrog")
id = "UML_12"
term = "Realization"
keyword = "Implementation"
definition = "A relationship between a classifier (e.g., a class) and an interface, where the classifier agrees to implement the operations specified by the interface, fulfilling a contract."
simple_terms = "Class promises to implement an interface."
examples = ["Class-Interface", "Component-Port", "Actor-UseCase"]
accepted_terms = ["Implements"]
difficulty = 2
related_to = ["UML Diagrams", "Software Design", "Structural Views"]
tof_statement = {
"false": "Realization means that one class contains instances of another class.", 
"true": "Realization ensures that a class provides the specific methods defined in an interface."
}
type_of_information = ["definition", "explain", "apply"]
clues = ["It signifies that one entity fulfills the contract of another.", "Often used with interfaces, showing a class provides its methods.", "Represented by a dashed line with an unfilled arrowhead."]
distractors = ["A type of inheritance where one class extends another.", "A relationship indicating a strong 'whole-part' dependency.", "A simple association between two independent classes."]
metadata/_custom_type_script = "uid://dadne10e1geqd"

