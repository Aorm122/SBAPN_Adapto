[sub_resource type="Resource" id="Resource_eng_06"]
script = ExtResource("1_7hrog")
id = "ENG_06"
term = "Irony"
keyword = "Expectation"
definition = "A literary device involving a contrast between what is said or expected and what actually happens or is meant, often creating a humorous or emphatic effect."
simple_terms = "When reality is different from what you expect or say."
examples = ["Fire station burns", "Huge dog named Tiny", "Rain on wedding day"]
accepted_terms = ["Dramatic Irony", "Situational Irony", "Verbal Irony"]
difficulty = 2
related_to = ["Literary Devices", "Narrative Techniques", "Textual Analysis"]
tof_statement = {
"false": "Irony is simply saying the opposite of what you mean without any underlying layers of meaning or exp", 
"true": "Irony challenges a reader's assumptions, prompting deeper thought about the discrepancy between appe"
}
type_of_information = ["definition", "explain", "apply"]
clues = ["It involves a twist or a surprise.", "What is stated or happens is not what you'd anticipate.", "Think about a character confidently walking into a trap the audience knows about."]
distractors = ["Sarcasm (direct mocking)", "Paradox (seemingly contradictory statement)", "Understatement (minimizing significance)"]
metadata/_custom_type_script = "uid://dadne10e1geqd"

