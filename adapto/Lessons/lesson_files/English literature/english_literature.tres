clues = ["It shows how two things are similar.", "You often see words like 'as' or 'like' in this comparison.", "Think about describing someone 'as strong as an ox'."]
distractors = ["Metaphor (direct equivalence)", "Hyperbole (exaggeration)", "Onomatopoeia (sound words)"]
metadata/_custom_type_script = "uid://dadne10e1geqd"

[sub_resource type="Resource" id="Resource_eng_03"]
script = ExtResource("1_7hrog")
id = "ENG_03"
term = "Alliteration"
keyword = "Sound"
definition = "The repetition of initial consonant sounds in words that are close together, used to create musicality, emphasize certain words, or establish a mood."
simple_terms = "Repeating the same first letter sound in nearby words."
examples = ["Peter Piper", "Silent snakes", "Wild wind"]
accepted_terms = []
difficulty = 1
related_to = ["Literary Devices", "Poetic Forms", "Textual Analysis"]
tof_statement = {
"false": "Alliteration involves repeating vowel sounds at the beginning of words for a similar effect.", 
"true": "Alliteration contributes to the rhythm and flow of a text, making it more memorable or impactful."
}
type_of_information = ["definition", "explain", "apply"]
clues = ["It deals with repeating sounds.", "Look for the same consonant sound at the start of words.", "Consider 'fuzzy, furry, friendly animals'."]
distractors = ["Assonance (vowel sound repetition)", "Consonance (consonant sound repetition within/end words)", "Rhyme (end word sound similarity)"]
metadata/_custom_type_script = "uid://dadne10e1geqd"

