[sub_resource type="Resource" id="Resource_eng_01"]
script = ExtResource("1_7hrog")
id = "ENG_01"
term = "Metaphor"
keyword = "Comparison"
definition = "A figure of speech that directly compares two unlike things by stating one IS the other, revealing a deeper conceptual connection without using \"like\" or \"as.\""
simple_terms = "Saying one thing is another to show similarity."
examples = ["Heart of stone", "Life's a journey", "Time is money"]
accepted_terms = []
difficulty = 1
related_to = ["Literary Devices", "Textual Analysis"]
tof_statement = {
"false": "Metaphors always use 'like' or 'as' to draw a comparison between two distinct entities.", 
"true": "A metaphor asserts an identity between two dissimilar things to illuminate a hidden quality."
}
type_of_information = ["definition", "explain", "apply"]
clues = ["It connects two different ideas.", "It speaks of one thing as if it were another.", "You might say 'the world is a stage'."]
distractors = ["Simile (uses 'like' or 'as')", "Personification (gives human traits)", "Alliteration (repeats initial sounds)"]
metadata/_custom_type_script = "uid://dadne10e1geqd"

[sub_resource type="Resource" id="Resource_eng_02"]
