[sub_resource type="Resource" id="Resource_pok_01"]
script = ExtResource("1_7hrog")
id = "POK_01"
term = "Type Effectiveness"
keyword = "Matchups"
definition = "Explains how certain elemental types interact, determining damage multipliers in battle. Understanding these interactions allows trainers to predict and exploit weaknesses or resist attacks strategically."
simple_terms = "Some types hit harder, some hit weaker. Choose wisely."
examples = ["Water beats Fire", "Grass beats Water", "Fire beats Grass"]
accepted_terms = ["Type Chart"]
difficulty = 1
related_to = ["Game Mechanics", "Strategy", "Battling"]
tof_statement = {
"false": "Type effectiveness only determines if an attack hits or misses its target.", 
"true": "Using a Fire-type attack against a Grass-type Pokémon deals increased damage."
}
type_of_information = ["definition", "explain", "apply"]
clues = ["It's about elemental interactions in combat.", "You consult a chart to understand these relationships.", "A common example involves Water, Fire, and Grass types."]
distractors = ["STAB", "Ability Effects", "Critical Hits"]
metadata/_custom_type_script = "uid://dadne10e1geqd"

