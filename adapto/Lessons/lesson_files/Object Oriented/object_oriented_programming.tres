[sub_resource type="Resource" id="Resource_oop_01"]
script = ExtResource("1_7hrog")
id = "OOP_01"
term = "Class"
keyword = "Blueprint"
definition = "Defines the blueprint for creating objects, specifying their attributes (data) and methods (behavior) to structure reusable code."
simple_terms = "A template for creating similar things."
examples = ["Car", "User", "Account"]
accepted_terms = ["Class type"]
difficulty = 1
related_to = ["OOP Principles", "Class Design", "Code Structure", "Methodology"]
tof_statement = {
"false": "A class is a specific instance of an object, holding unique data.", 
"true": "A class acts as a blueprint, allowing developers to define the structure and behavior for objects."
}
type_of_information = ["definition", "explain", "apply"]
clues = ["It's like a recipe.", "It describes what an object can be and do.", "You instantiate this to create an object."]
distractors = ["An actual data entity in memory.", "A function that returns multiple values.", "A simple variable declaration."]
metadata/_custom_type_script = "uid://dadne10e1geqd"

[sub_resource type="Resource" id="Resource_oop_02"]
script = ExtResource("1_7hrog")
id = "OOP_02"
term = "Object"
keyword = "Instance"
definition = "Represents a concrete instance of a class, holding its own unique set of attribute values and able to perform the behaviors defined by its class."
simple_terms = "A specific, tangible entity created from a template."
examples = ["myCar", "newUser", "savingsAccount"]
accepted_terms = ["Instance"]
difficulty = 1
related_to = ["OOP Principles", "Class Design", "Code Structure", "Methodology"]
tof_statement = {
"false": "An object defines the general structure and behavior for a category of entities.", 
"true": "An object is a runtime entity created from a class, possessing specific state and behavior."
}
type_of_information = ["definition", "explain", "apply"]
clues = ["It's what you build from a blueprint.", "It has a unique state.", "You create this using a constructor."]
distractors = ["A definition of data types.", "A static collection of methods.", "The class itself, before instantiation."]
metadata/_custom_type_script = "uid://dadne10e1geqd"

[sub_resource type="Resource" id="Resource_oop_03"]
script = ExtResource("1_7hrog")
id = "OOP_03"
term = "Encapsulation"
keyword = "Hiding"
definition = "The principle of bundling data and methods that operate on the data within a single unit, and restricting direct access to some of the object's components."
simple_terms = "Keeps data and its operations together, controls access."
examples = ["Private fields", "Public methods", "Getters/Setters"]
accepted_terms = ["Information Hiding"]
difficulty = 2
related_to = ["OOP Principles", "Class Design", "Code Structure", "Methodology"]
tof_statement = {
"false": "Encapsulation means making all object data publicly accessible for easy modification.", 
"true": "Encapsulation helps protect an object's internal state by restricting direct access to its data."
}
type_of_information = ["definition", "explain", "apply"]
clues = ["It's about packaging and protection.", "Think about a pill's outer shell.", "Access modifiers like private and public are key to this principle."]
distractors = ["The ability to take many forms.", "Creating new classes from existing ones.", "Defining abstract methods without implementation."]
metadata/_custom_type_script = "uid://dadne10e1geqd"

[sub_resource type="Resource" id="Resource_oop_04"]
script = ExtResource("1_7hrog")
id = "OOP_04"
term = "Inheritance"
keyword = "Extension"
definition = "A mechanism where a new class (derived/child) acquires the properties and behaviors of an existing class (base/parent), promoting code reuse and establishing a hierarchy."
simple_terms = "New classes reuse behavior from existing ones."
examples = ["Dog extends Animal", "Car extends Vehicle", "Manager extends Employee"]
accepted_terms = ["Subclassing"]
difficulty = 2
related_to = ["OOP Principles", "Class Design", "Code Structure", "Methodology"]
tof_statement = {
"false": "Inheritance is primarily used to define multiple implementations for a single method signature.", 
"true": "Inheritance allows a subclass to inherit fields and methods from a superclass, fostering code reuse."
}
type_of_information = ["definition", "explain", "apply"]
clues = ["It's about 'is-a' relationships.", "Think about family trees in code.", "A child class can gain functionality from its parent."]
distractors = ["Defining multiple methods with the same name but different parameters.", "Hiding internal data from external access.", "Implementing a common interface across different classes."]
metadata/_custom_type_script = "uid://dadne10e1geqd"

[sub_resource type="Resource" id="Resource_oop_05"]
script = ExtResource("1_7hrog")
id = "OOP_05"
term = "Polymorphism"
keyword = "Many Forms"
definition = "The ability of objects of different classes to respond to the same method call in their own specific ways, enabling flexibility and dynamic behavior."
simple_terms = "One interface, many implementations; adapting behavior."
examples = ["Animal.makeSound()", "Shape.draw()", "Printer.print()"]
accepted_terms = ["Runtime Polymorphism", "Method Overriding"]
difficulty = 2
related_to = ["OOP Principles", "Class Design", "Code Structure", "Methodology"]
tof_statement = {
"false": "Polymorphism means that an object can change its class type at runtime.", 
"true": "Polymorphism allows a single interface to represent different underlying forms or types of objects."
}
type_of_information = ["definition", "explain", "apply"]
clues = ["It means 'many forms'.", "Think about a remote control for different devices.", "Method overriding is a key mechanism for achieving this."]
distractors = ["Bundling data and methods together.", "Creating new classes from existing ones.", "Restricting access to an object's internal state."]
metadata/_custom_type_script = "uid://dadne10e1geqd"

[sub_resource type="Resource" id="Resource_oop_06"]
