[sub_resource type="Resource" id="Resource_oop_31"]
script = ExtResource("1_7hrog")
id = "OOP_31"
term = "Base Class"
keyword = "Parent"
definition = "The class from which other classes (derived classes) inherit properties and behaviors, forming the top or higher level in an inheritance hierarchy."
simple_terms = "The original or parent class that other classes extend."
examples = ["Animal", "Vehicle", "Person"]
accepted_terms = ["Parent Class", "Superclass"]
difficulty = 1
related_to = ["OOP Principles", "Class Design", "Code Structure"]
tof_statement = {
"false": "A base class is always an interface that only defines abstract methods.", 
"true": "A base class is a class from which other classes inherit, providing common functionality."
}
type_of_information = ["definition", "explain", "apply"]
clues = ["It's the foundation of an inheritance chain.", "Child classes get their initial traits from this.", "It's often referred to as a 'parent'."]
distractors = ["A class that inherits from another class.", "A class that cannot be instantiated.", "A class that only contains static members."]
metadata/_custom_type_script = "uid://dadne10e1geqd"

[sub_resource type="Resource" id="Resource_oop_32"]
script = ExtResource("1_7hrog")
id = "OOP_32"
term = "Derived Class"
keyword = "Child"
definition = "A class that inherits attributes and methods from another class (its base class), extending or specializing the base class's functionality."
simple_terms = "A new class that gets features from an existing parent cl..."
examples = ["Dog", "Car", "Employee"]
accepted_terms = ["Child Class", "Subclass"]
difficulty = 1
related_to = ["OOP Principles", "Class Design", "Code Structure"]
tof_statement = {
"false": "A derived class is completely independent and shares no functionality with any other class.", 
"true": "A derived class inherits properties and behaviors from a base class, often specializing them."
}
type_of_information = ["definition", "explain", "apply"]
clues = ["It's the offspring in an inheritance relationship.", "It can add new features or change existing ones from its parent.", "It often uses the 'extends' keyword."]
distractors = ["The original class from which others inherit.", "A class that defines only abstract methods.", "A class that serves as a utility collection of static methods."]
