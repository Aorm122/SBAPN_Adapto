[sub_resource type="Resource" id="Resource_oop_30"]
script = ExtResource("1_7hrog")
id = "OOP_30"
term = "Encapsulated Data"
keyword = "Protected State"
definition = "The internal state or attributes of an object that are hidden from direct external access, typically controlled through public methods (getters/setters)."
simple_terms = "Object's internal information, kept private and controlled."
examples = ["private balance", "customerID", "internal state"]
accepted_terms = ["Private Data"]
difficulty = 1
related_to = ["OOP Principles", "Class Design", "Code Structure"]
tof_statement = {
"false": "Encapsulated data means the data is publicly available for modification by any part of the program.", 
"true": "Encapsulated data refers to an object's internal state that is protected from direct external modifi"
}
type_of_information = ["definition", "explain", "apply"]
clues = ["It's the stuff inside an object that's kept secret.", "You usually need special methods to interact with it.", "It's a core aspect of information hiding."]
distractors = ["Data that is shared globally across all classes.", "Methods that perform actions on an object.", "Data that is only accessible by static methods."]
