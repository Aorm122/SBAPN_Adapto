clues = ["It's about 'what' something does, not 'how'.", "Think about driving a car without knowing its engine mechanics.", "Interfaces and abstract classes are tools for this."]
distractors = ["The ability of objects to take on many forms.", "Bundling data and methods into a single unit.", "Creating new classes by extending existing ones."]
