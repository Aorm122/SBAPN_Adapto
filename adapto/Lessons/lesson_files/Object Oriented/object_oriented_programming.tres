[sub_resource type="Resource" id="Resource_oop_25"]
script = ExtResource("1_7hrog")
id = "OOP_25"
term = "Message Passing"
keyword = "Interaction"
definition = "The process where objects communicate by sending and receiving messages (method calls), requesting services or information from other objects."
simple_terms = "Objects talking to each other by calling methods."
examples = ["car.startEngine()", "user.authenticate()", "database.save(data)"]
accepted_terms = ["Method Invocation"]
difficulty = 2
related_to = ["OOP Principles", "Code Structure", "Methodology"]
tof_statement = {
"false": "Message passing is a mechanism for direct memory access between unrelated objects.", 
"true": "Message passing is how objects interact and communicate by invoking each other's methods."
}
type_of_information = ["definition", "explain", "apply"]
clues = ["It's how objects 'talk' to each other.", "It involves one object invoking a behavior on another.", "This is fundamental to object interaction in OOP."]
distractors = ["The process of creating new objects.", "Hiding internal data from external access.", "Defining the structure of an object."]
metadata/_custom_type_script = "uid://dadne10e1geqd"

[sub_resource type="Resource" id="Resource_oop_26"]
script = ExtResource("1_7hrog")
id = "OOP_26"
term = "Cohesion"
keyword = "Relatedness"
definition = "A qualitative measure of how well the elements within a module or class belong together, indicating a single, well-defined purpose."
simple_terms = "How focused and single-purposed a class or module is."
examples = ["High Cohesion", "Low Cohesion", "Single Responsibility"]
accepted_terms = ["Functional Cohesion"]
difficulty = 3
related_to = ["Design Patterns", "Methodology", "Code Structure"]
tof_statement = {
"false": "High cohesion implies that a class handles many unrelated tasks, making it highly reusable.", 
"true": "High cohesion means that the elements within a module or class are strongly related and focused on a"
}
type_of_information = ["definition", "explain", "apply"]
clues = ["It's about having a clear, unified job.", "A well-designed class should exhibit a lot of this.", "The Single Responsibility Principle (SRP) promotes this quality."]
distractors = ["The degree of interdependence between different modules.", "How accessible internal data is to external modules.", "The ability of an object to take on many forms."]
metadata/_custom_type_script = "uid://dadne10e1geqd"

[sub_resource type="Resource" id="Resource_oop_27"]
script = ExtResource("1_7hrog")
id = "OOP_27"
term = "Coupling"
keyword = "Interdependence"
definition = "A qualitative measure of the degree of interdependence between software modules or classes, aiming for loose coupling to improve flexibility and maintainability."
simple_terms = "How much different parts of the code rely on each other."
examples = ["Loose Coupling", "Tight Coupling", "Parameter Passing"]
accepted_terms = ["Interdependence"]
difficulty = 3
related_to = ["Design Patterns", "Methodology", "Code Structure"]
tof_statement = {
"false": "Tight coupling is preferred in software design because it simplifies development.", 
"true": "Loose coupling is desirable as it reduces the impact of changes in one module on other modules."
}
type_of_information = ["definition", "explain", "apply"]
clues = ["It's about how much one part 'knows' about another.", "Reducing this makes systems easier to change.", "Dependency injection is a technique to manage this."]
distractors = ["How well elements within a single module belong together.", "The process of bundling data and methods within a single unit.", "The ability of a class to inherit properties from another class."]
metadata/_custom_type_script = "uid://dadne10e1geqd"

